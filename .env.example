# Copy this file to .env and fill in real values.
# NEVER put real credentials in this file — it is committed to git.
# .env itself is gitignored and is where the real values belong.

# ---- Server ----
PORT=3000

# ---- MySQL (Hostinger) ----
# Remote access uses your Hostinger DB hostname (e.g. srvXXX.hstgr.io).
# When the app runs on Hostinger itself, this is usually localhost.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---- Auth ----
# Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- AI provider ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
